# ZTF_prompt 环境变量
# 复制此文件为 .env 并填入真实 key
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.llm.ustc.edu.cn/v1
LLM_MODEL=qwen3.6-reasoner

# 每请求 completion token 预算（默认 12000）。
# 推理型模型开着服务端思考时，reasoning token 也占这个预算；
# 给太小会导致 content 为空（看起来像"不读图/不回答"，实为被截断）。
LLM_MAX_TOKENS=12000

# 服务端思考链开关（默认 false）。分类任务建议保持 false。
# LLM_SERVER_COT=false

# 是否沿用 shell 的代理环境变量（默认 false = 直连）。
# 机器上若有 ALL_PROXY=socks://... 全局代理，httpx 会在建客户端时
# 直接报 "Unknown scheme for proxy URL"，使所有 LLM 调用失败。
# LLM_TRUST_ENV=false

# 可选：第二个模型用于对比实验
# LLM_MODEL_ALT=deepseek-v4-pro